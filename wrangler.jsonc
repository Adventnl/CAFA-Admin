{
  // One Worker serves both halves of the admin: the built SPA as static assets,
  // and the /api and /auth routes that hold the GitHub token. The token never
  // reaches the browser, which is the whole reason there is a server here at all.
  "name": "cafa-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A single-page app: unknown paths are routes the client router owns, not
    // 404s. The Worker checks /api and /auth first, so this never shadows them.
    "not_found_handling": "single-page-application"
  },

  "vars": {
    // The only GitHub account allowed to sign in. Everyone else is refused
    // after the OAuth round trip, before a session is ever issued.
    "OWNER_LOGIN": "adventnl",

    // The repository this admin edits.
    "REPO_OWNER": "Adventnl",
    "REPO_NAME": "CAFA-Template",

    // Where edits land, and where publishing sends them.
    "DRAFT_BRANCH": "draft",
    "PRODUCTION_BRANCH": "main",

    // Polled for build-info.json to answer "is what I published actually live".
    "PRODUCTION_URL": "https://cafa.hanoryx.com"

    // PREVIEW_URL is set once Cloudflare has built the draft branch once and
    // its alias exists. Without it the admin simply shows no preview link.
  }

  // Secrets, set with `wrangler secret put <name>`:
  //   GITHUB_CLIENT_ID      — the OAuth app's client id
  //   GITHUB_CLIENT_SECRET  — the OAuth app's client secret
  //   SESSION_SECRET        — 32+ random bytes; signs and encrypts the cookie
}
