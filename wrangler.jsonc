{
  // One Worker serves both halves of the admin: the built SPA as static assets,
  // and the /api and /auth routes that hold the session and the only writable
  // handle on the content.
  "name": "cafa-admin",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-05",
  "compatibility_flags": ["nodejs_compat"],

  // The editor's own hostname. A custom domain rather than a route, so
  // Cloudflare owns the DNS record and the certificate and there is no
  // fall-through to an origin — the Worker is the origin.
  //
  // Changing this means changing the GitHub OAuth app's callback URL to match:
  // handleLogin derives the redirect from the request's own origin, so the two
  // agree by construction, but GitHub still checks it against what is
  // registered. See README §3.
  "routes": [{ "pattern": "admin.cafa-studio.com", "custom_domain": true }],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // A single-page app: unknown paths are routes the client router owns, not
    // 404s. The Worker checks /api and /auth first, so this never shadows them.
    "not_found_handling": "single-page-application"
  },

  // The content. Create it once with:
  //   npx wrangler d1 create cafa-content
  // then paste the id it prints in here, and apply the schema with:
  //   npx wrangler d1 migrations apply cafa-content --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cafa-content",
      "database_id": "REPLACE_WITH_THE_ID_WRANGLER_PRINTS",
      "migrations_dir": "migrations"
    }
  ],

  // The photographs. Create it once with:
  //   npx wrangler r2 bucket create cafa-media
  // then connect a custom domain to it in the bucket's settings, so the
  // template can point image transformations at a stable origin.
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "cafa-media"
    }
  ],

  "vars": {
    // The only GitHub account allowed to sign in. Everyone else is refused
    // after the OAuth round trip, before a session is ever issued.
    "OWNER_LOGIN": "adventnl",

    // Where the R2 originals are served from. The template appends the object
    // key to this and asks Cloudflare to transform the result, so it is the one
    // place that decides where photographs come from.
    //
    // A subdomain of the site's own zone on purpose: /cdn-cgi/image/ runs on
    // the zone the *page* is served from, and keeping the origin inside that
    // same zone means no second TLS handshake on the LCP path.
    "MEDIA_BASE": "https://media.cafa-studio.com",

    // The public site's origin, and now the only place that says where it is.
    //
    // Two things read it. The admin polls it for build-info.json, to answer "is
    // what I published actually live". And worker/domain/bundle.ts stamps it into the
    // published bundle as `site.url`, which is what the template builds every
    // canonical, hreflang, og:url and sitemap entry from — so a domain move is
    // this line plus a redeploy, not a database edit nobody remembers to make.
    //
    // No trailing slash: it is used as a URL base, and a trailing slash would
    // survive into every absolute URL derived from it.
    "PRODUCTION_URL": "https://cafa-studio.com"

    // PREVIEW_URL is set once the preview Worker has built once and its alias
    // exists. Without it the admin simply shows no preview link.
  }

  // Secrets, set with `wrangler secret put <name>`:
  //   GITHUB_CLIENT_ID         — the OAuth app's client id
  //   GITHUB_CLIENT_SECRET     — the OAuth app's client secret
  //   SESSION_SECRET           — 32+ random bytes; signs and encrypts the cookie
  //   DEPLOY_HOOK_URL          — poked on publish; rebuilds the live site
  //   PREVIEW_DEPLOY_HOOK_URL  — poked on save; rebuilds the preview
  //   PREVIEW_TOKEN            — lets the preview build read unpublished work
  //
  // The three deploy-related secrets are all optional. Without DEPLOY_HOOK_URL
  // publishing still writes a revision, it just does not trigger the build;
  // without the preview pair there is simply no preview.
}
